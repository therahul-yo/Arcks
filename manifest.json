{
  "manifest_version": 3,
  "name": "Arcks",
  "version": "1.0.0",
  "description": "Arc-style AI link previews on hover",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Arcks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.co.in/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.co.kr/search*",
        "*://www.google.co.id/search*",
        "*://www.google.com.au/search*",
        "*://www.google.com.br/search*",
        "*://www.google.com.mx/search*",
        "*://www.google.com.sg/search*",
        "*://www.google.com.tr/search*",
        "*://www.google.ca/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.pl/search*",
        "*://www.google.ru/search*",
        "*://www.google.se/search*",
        "*://www.google.ch/search*",
        "*://www.google.be/search*",
        "*://www.google.ie/search*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  }
}
